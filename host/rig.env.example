# Settings for this rig, loaded by scripts/rig.sh. Copy to host/rig.env
# (git-ignored) and adjust; locations are specific to each machine.

# The host's serial port. Needed for the Feather RP2040 + Floppy FeatherWing:
# `gw` only finds a real Greaseweazle by itself. List ports with
# `ls /dev/cu.usbmodem*`; the drive (BB48) is the other one.
export FDDPRO_GW_DEVICE=/dev/cu.usbmodemXXXX

# Which drive `gw` addresses. Our drive answers on pins 12 (select) and 16
# (motor), as a PC drive does.
#   Feather + FeatherWing: A, its only drive select, which uses pins 12/16.
#   Greaseweazle, straight cable: B (A would be pins 14/10).
export FDDPRO_GW_DRIVE=A

# The drive's own serial port, if it can't be found by its USB product name.
# export FDDPRO_PORT=/dev/cu.usbmodemYYYY
