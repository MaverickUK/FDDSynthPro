# Settings for this rig, loaded by scripts/rig.sh. Copy to host/rig.env
# (git-ignored) and adjust; locations are specific to each machine.

# Which drive the Greaseweazle addresses: A (pins 14/10) or B (pins 12/16) on
# the IBM PC bus. A PC drive answers on pins 12/16, so with a straight cable
# from the Greaseweazle that is B; after the cable's twist it is A.
export FDDPRO_GW_DRIVE=B

# The Greaseweazle's serial port, if `gw` can't find it by itself.
# export FDDPRO_GW_DEVICE=/dev/cu.usbmodemXXXX

# The drive's own serial port, if it can't be found by its USB product name.
# export FDDPRO_PORT=/dev/cu.usbmodemYYYY
